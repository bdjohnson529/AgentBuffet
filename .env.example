## Copy to .env and fill in values.
##
## Never commit your real .env (it's gitignored).

# --- LLM provider keys (set one or both) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional model overrides ---
# OPENAI_MODEL=gpt-4.1-mini
# ANTHROPIC_MODEL=claude-opus-4-6

# --- Optional: SEC User-Agent (recommended by EDGAR fair access policy) ---
# Example: "AgentBuffet/1.0 (your.email@example.com)"
SEC_USER_AGENT=

